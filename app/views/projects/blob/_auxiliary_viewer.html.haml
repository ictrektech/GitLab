- blob = local_assigns.fetch(:blob)
- ref = local_assigns.fetch(:ref)
- auxiliary_viewer = blob.auxiliary_viewer
- if auxiliary_viewer && auxiliary_viewer.render_error.nil? && auxiliary_viewer.visible_to?(current_user, ref)
  .blob-auxiliary-viewer.gl-px-4.gl-py-3.gl-border-t
    = render 'projects/blob/viewer', viewer: auxiliary_viewer
