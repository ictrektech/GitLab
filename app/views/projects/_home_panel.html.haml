- content_for :static_panel_actions do
  .js-show-on-project-root
    #js-home-panel{ data: home_panel_data_attributes }

%span.gl-flex.gl-items-center.gl-gap-4.gl-pt-2.-gl-mb-5
  = render Pajamas::AvatarComponent.new(@project, alt: '', class: 'gl-font-normal gl-self-start gl-shrink-0', size: 48, avatar_options: { itemprop: 'image', aria: { hidden: "true" } })
  %span.gl-flex.gl-items-center.gl-flex-wrap.gl-gap-x-3.gl-gap-y-1.gl-break-anywhere
    %span{ data: { testid: 'project-name-content' }, itemprop: 'name' }= @project.name
    = visibility_level_content(@project, css_class: 'visibility-icon gl-inline-flex', icon_variant: 'subtle')
    - if @project.catalog_resource
      = render partial: 'shared/ci_catalog_badge', locals: { href: explore_catalog_path(@project.catalog_resource), css_class: 'gl-mx-0', is_published: @project.catalog_resource.published? }
    - if @project.group
      = render_if_exists 'shared/tier_badge', source: @project
    = render 'shared/projects/badges', project: @project
