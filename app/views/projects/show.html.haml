- current_route_path = request.fullpath.match(%r{-/tree/[^/]+/(.+$)}).to_a[1]
- @skip_current_level_breadcrumb = true
- @force_show_panel_header = true
- add_page_specific_style 'page_bundles/project'
- add_page_specific_style 'page_bundles/tree'

= content_for :meta_tags do
  = auto_discovery_link_tag(:atom, project_path(@project, rss_url_options), title: "#{@project.name} activity")

= render partial: 'flash_messages', locals: { project: @project }

= render 'clusters_deprecation_alert'
= render "projects/last_push"

- mirror_status = render_if_exists "projects/home_mirror"

= render ::Layouts::DetailLayout.new(sidebar_first: true, options: { class: 'project-home-layout' }) do |c|
  - c.with_heading do
    = render "home_panel"
  - if mirror_status.present?
    - c.with_description do
      = mirror_status
  - c.with_sidebar do
    .project-home-sidebar.js-show-on-project-root
      = render "sidebar"

  - if can?(current_user, :read_code, @project) && @project.repository_languages.present?
    - add_page_startup_graphql_call('repository/path_last_commit', { projectPath: @project.full_path, ref: current_ref, path: current_route_path || "" })

  - view_path = @project.default_view

  %div{ class: project_child_container_class(view_path) }
    = render view_path, is_project_overview: true
